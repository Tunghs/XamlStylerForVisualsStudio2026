<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
    <!-- Modified by Tunghs in 2026 for the Visual Studio 2026 distribution. -->
    <Metadata>
        <Identity Id="Tunghs.XamlStylerForVisualStudio2026" Version="1.0.0.0" Language="en-US" Publisher="Tunghs" />
        <DisplayName>XAML Styler for Visual Studio 2026</DisplayName>
        <Description xml:space="preserve">An unofficial Visual Studio 2026 build of XAML Styler that formats XAML source code based on configurable styling rules.</Description>
        <MoreInfo>https://github.com/Tunghs/XamlStylerForVisualsStudio2026</MoreInfo>
        <License>LICENSE</License>
        <GettingStartedGuide>https://github.com/Xavalon/XamlStyler/wiki/Getting-Started</GettingStartedGuide>
        <Icon>Resources\icon128.jpg</Icon>
        <PreviewImage>Resources\icon200.jpg</PreviewImage>
        <Tags>formatting,format,formatter,style,uwp,wpf,xaml</Tags>
    </Metadata>
    <!-- Visual Studio 2026 supports extensions targeting the stable Visual Studio 17.x API surface. -->
    <Installation>
        <InstallationTarget Version="[17.8,)" Id="Microsoft.VisualStudio.Community">
            <ProductArchitecture>amd64</ProductArchitecture>
        </InstallationTarget>
        <InstallationTarget Version="[17.8,)" Id="Microsoft.VisualStudio.Community">
            <ProductArchitecture>arm64</ProductArchitecture>
        </InstallationTarget>
    </Installation>
    <Dependencies>
    </Dependencies>
    <Assets>
        <Asset Type="Microsoft.VisualStudio.VsPackage" d:Source="Project" d:ProjectName="%CurrentProject%" Path="|%CurrentProject%;PkgdefProjectOutputGroup|" />
    </Assets>
    <Prerequisites>
        <!-- Visual Studio extensions and version ranges demystified: https://devblogs.microsoft.com/visualstudio/visual-studio-extensions-and-version-ranges-demystified/ -->
        <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor" Version="[15.0,)" DisplayName="Visual Studio core editor" />
    </Prerequisites>
</PackageManifest>
